{
  "name": "ccToggle",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:preload && vue-tsc --noEmit && vite build",
    "build:preload": "tsc -p tsconfig.preload.json && cp src/preload/package.json src/preload/proxy-daemon.html public/preload/",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@vicons/ionicons5": "^0.13.0",
    "chart.js": "^4.5.1",
    "chartjs-chart-matrix": "^3.0.5",
    "marked": "^18.0.7",
    "naive-ui": "^2.44.1",
    "vue": "^3.5.0",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/tsconfig": "^0.9.1",
    "sass": "^1.102.0",
    "sharp": "^0.35.3",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "utools-api-types": "^7.5.1",
    "vite": "^6.0.0",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vue-tsc": "^3.3.9"
  },
  "author": "dfy",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
